# Example process environment for the Postfix pipe. Choose the region where
# the sending identity is verified. The binary does not load dotenv files.
AWS_REGION=us-east-1

# Optional controlled SES v2 HTTPS origin and readable PEM CA bundle.
# Leave both unset for the standard regional SES endpoint and system trust.
# AWS_ENDPOINT_URL_SES=https://ses.test.example
# AWS_CA_BUNDLE=/etc/postfix/ses-test-ca.pem

# Provide a send-only runtime identity through the AWS SDK credential chain.
# For a protected shared credentials file, the pipe user needs read access.
# AWS_SHARED_CREDENTIALS_FILE=/etc/postfix/ses-credentials
